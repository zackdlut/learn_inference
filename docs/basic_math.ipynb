   "source": [
    "%matplotlib inline\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def linear_function_1d(x,beta,omega):\n",
    "    y = beta + omega * x\n",
    "    return y\n",
    "\n",
    "x = np.arange(0,10,0.1)\n",
    "beta = 0.0; omega = 1.0\n",
    "y = linear_function_1d(x,beta,omega)\n",
    "\n",
    "plt.plot(x,y)\n",
    "plt.show()\n"
   ]
  }
 ],
